# JIRA_URL / CONFLUENCE_URL are intentionally empty here: set them in the repo-root .env.
# Non-secret Jira / Confluence Data Center settings for the qa-design harness.
# Tokens do NOT go here: put JIRA_PERSONAL_TOKEN / CONFLUENCE_PERSONAL_TOKEN in the repo-root .env
# (gitignored, see .env.example). Values in .env or the process environment override this file.
JIRA_URL=
CONFLUENCE_URL=
# Jira projects and Confluence spaces the agent may read. Spaces taken from links already in this repo
# (README.md, Documentation/FCAS.md). Pages in other spaces are recorded but never read.
JIRA_PROJECTS_FILTER=ITAPPSIT,BDAP
CONFLUENCE_SPACES_FILTER=XP,PMENA,AUC
MCP_ATLASSIAN_VERSION=0.23.1
JIRA_SSL_VERIFY=true
CONFLUENCE_SSL_VERIFY=true
