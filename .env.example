# Local secrets for the qa-design harness. Copy to .env (gitignored) and fill in; never commit .env.
# Personal Access Tokens: Jira / Confluence -> profile -> Personal Access Tokens. Read access is enough.
JIRA_PERSONAL_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
# Service hosts (internal, keep out of tracked files)
JIRA_URL=
CONFLUENCE_URL=
GH_HOST=
IDS_DB_REPLICA_HOST=
